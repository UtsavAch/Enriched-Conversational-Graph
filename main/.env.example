# ── LLM provider (pick ONE block) ────────────────────────────────────────────

# Option A: Anthropic Claude (cloud)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B: OpenAI-compatible local endpoint (Ollama, vLLM, LM Studio)
# Uncomment and fill in to use a local SLM instead of Anthropic.
# GM_OPENAI_BASE_URL=http://localhost:11434/v1
# GM_OPENAI_API_KEY=ollama          # leave as "ollama" for Ollama; use real key for vLLM

# ── Model selection ───────────────────────────────────────────────────────────
# Defaults shown. Override only if needed.
# GM_ANSWER_MODEL=claude-sonnet-4-6
# GM_EXTRACTION_MODEL=claude-sonnet-4-6
# GM_EMBEDDING_MODEL=hashing        # "hashing" (fast, no deps) or "sentence-transformers"

# ── Storage ───────────────────────────────────────────────────────────────────
# GM_DATA_ROOT=/absolute/path/to/data   # default: main/data/

# ── Feature flags ─────────────────────────────────────────────────────────────
# Uncomment to enable the live /api/chat/turn endpoint.
# Single-process only — does not scale across multiple Uvicorn workers.
# GM_ENABLE_CHAT=1
