# ── LLM provider (pick ONE block) ────────────────────────────────────────────

# Option A: Anthropic Claude (cloud)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B: OpenAI-compatible local endpoint (Ollama, vLLM, LM Studio)
# Takes priority over ANTHROPIC_API_KEY when set.
# GM_OPENAI_BASE_URL=http://localhost:11434/v1
# Leave as "ollama" for Ollama; use a real key for vLLM or OpenAI.
# GM_OPENAI_API_KEY=ollama

# ── Model selection ───────────────────────────────────────────────────────────
# Defaults shown. Override only if needed.
# GM_ANSWER_MODEL=claude-sonnet-4-6, llama3.1:8b, etc.
# GM_EXTRACTION_MODEL=claude-sonnet-4-6, llama3.1:8b, etc.
# "hashing" (fast, no extra deps) or "sentence-transformers" (matches baseline)
# GM_EMBEDDING_MODEL=hashing

# ── Storage ───────────────────────────────────────────────────────────────────
# Uncomment to override. Default resolves to main/data/ relative to project root.
# GM_DATA_ROOT=/absolute/path/to/data

# ── Feature flags ─────────────────────────────────────────────────────────────
# Enable the live /api/chat/turn endpoint.
# Single-process only — does not survive multiple Uvicorn workers.
# GM_ENABLE_CHAT=1
