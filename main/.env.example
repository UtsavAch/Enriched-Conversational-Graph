# ── LLM provider (pick ONE block) ────────────────────────────────────────────

# Option A: Anthropic Claude (cloud, paid)
ANTHROPIC_API_KEY=sk-ant-your-key-here

# Option B: OpenAI-compatible endpoint - local (Ollama, vLLM, LM Studio) or
# cloud (Groq's free tier, OpenAI, any provider that speaks the OpenAI chat-
# completions API). Takes priority over ANTHROPIC_API_KEY when set.
# GM_OPENAI_BASE_URL=http://localhost:11434/v1
# Groq free tier: GM_OPENAI_BASE_URL=https://api.groq.com/openai/v1
# (Groq's free-tier catalog changes over time - list current models with:
#  python -c "from openai import OpenAI; import os; [print(m.id) for m in OpenAI(base_url=os.environ['GM_OPENAI_BASE_URL'], api_key=os.environ['GM_OPENAI_API_KEY']).models.list().data]")
# Leave as "ollama" for Ollama; use your real key for Groq/vLLM/OpenAI.
# GM_OPENAI_API_KEY=ollama

# ── Embeddings ────────────────────────────────────────────────────────────────
# "hashing" (offline stub, meaningless similarity - dev/plumbing only),
# "sentence-transformers" model id (real, local, free), or "gemini" (real,
# cloud, free tier - the recommended pairing with Groq above, since Groq has
# no embeddings endpoint of its own).
# GM_EMBEDDING_MODEL=hashing

# Required only when GM_EMBEDDING_MODEL=gemini. Free key from
# aistudio.google.com - independent of whichever provider GM_OPENAI_BASE_URL
# points at for extraction/answers.
# GEMINI_API_KEY=your-gemini-key-here

# ── Rate limiting ─────────────────────────────────────────────────────────────
# Unset by default (no throttling - fine for Ollama/Anthropic/unrestricted use).
# Set one or both when using a free-tier cloud provider, comfortably under
# whatever it actually allows (found by testing live, not just reading docs -
# provider limits and even model catalogs change). Example free-tier values
# found this way: Groq ~7000 (of a free 8000 TPM cap, org-wide, applies across
# whichever model you use); Gemini flash-lite ~12 (of a free 15 RPM cap, per-model).
# GM_RPM_LIMIT=12
# GM_TPM_LIMIT=7000

# ── Model selection ───────────────────────────────────────────────────────────
# Defaults shown. Override only if needed.
# GM_ANSWER_MODEL=claude-sonnet-5, openai/gpt-oss-120b (Groq - check console.groq.com/docs/models, their free catalog changes), llama3.1:8b (Ollama), etc.
# GM_EXTRACTION_MODEL=claude-sonnet-5, openai/gpt-oss-120b (Groq - check console.groq.com/docs/models, their free catalog changes), llama3.1:8b (Ollama), etc.

# ── Storage ───────────────────────────────────────────────────────────────────
# Uncomment to override. Default resolves to main/data/ relative to project root.
# GM_DATA_ROOT=/absolute/path/to/data

# ── Feature flags ─────────────────────────────────────────────────────────────
# Enable the live /api/chat/turn endpoint.
# Single-process only — does not survive multiple Uvicorn workers.
# GM_ENABLE_CHAT=1
